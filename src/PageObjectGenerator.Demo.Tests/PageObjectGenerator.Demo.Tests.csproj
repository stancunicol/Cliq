<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit.Analyzers" Version="3.9.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Selenium.Support" Version="4.46.0" />
    <PackageReference Include="Selenium.WebDriver" Version="4.46.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <!-- Every generated Page Object/.Custom.cs is compiled automatically, so a
       syntax or escaping bug in any generated file is caught by "dotnet
       build" without editing this file per new page. *Tests.cs is
       deliberately excluded from the wildcard: running every generated
       page's NUnit fixture would mean launching a real browser against
       whatever real, uncontrolled site it was generated from on every test
       run. Tried it (see git history) - WwwEmagRoPageTests alone produced
       162 failures out of 183 because the live emag.ro homepage's product
       listing had simply changed since generation, unrelated to any code
       bug. LoginPageTests is the one exception, kept as the single live E2E
       example, run against a stable test fixture (the-internet.herokuapp.com)
       instead of a real external site. LoginPage.Custom.cs also proves the
       partial-class split actually compiles together: a hand-written method
       there calling generated methods here. -->
  <ItemGroup>
    <Compile Include="..\..\GeneratedPages\*.cs" Exclude="..\..\GeneratedPages\*Tests.cs" Link="Generated\%(Filename)%(Extension)" />
    <Compile Include="..\..\GeneratedPages\LoginPageTests.cs" Link="Generated\LoginPageTests.cs" />
  </ItemGroup>

</Project>
