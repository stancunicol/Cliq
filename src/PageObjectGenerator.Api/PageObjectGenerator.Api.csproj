<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\PageObjectGenerator.Core\PageObjectGenerator.Core.csproj" />
  </ItemGroup>

  <!-- If this project's CWD default ever lands a GeneratedPages/ output folder
       under its own directory, don't let the SDK's implicit **/*.cs glob try
       to compile that runtime-generated code as part of the API itself. -->
  <ItemGroup>
    <Compile Remove="GeneratedPages\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
