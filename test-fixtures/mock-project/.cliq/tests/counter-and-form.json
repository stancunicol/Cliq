{
  "schemaVersion": 1,
  "id": "counter-and-form",
  "name": "Counter and form interactions",
  "description": "Demonstrates click, text assertion, input, and select actions on the sample page.",
  "tags": [
    "demo",
    "smoke"
  ],
  "steps": [
    {
      "id": "open-sample-page",
      "action": "navigate",
      "label": "Open the sample page",
      "enabled": true,
      "url": "http://127.0.0.1:4174/"
    },
    {
      "id": "increment-counter",
      "action": "click",
      "label": "Increment the counter",
      "enabled": true,
      "pageId": "recorder-fixture",
      "elementId": "increment-counter"
    },
    {
      "id": "verify-counter",
      "action": "assertText",
      "label": "Verify the counter value",
      "enabled": true,
      "pageId": "recorder-fixture",
      "elementId": "counter-output",
      "value": {
        "kind": "literal",
        "value": "Count: 1"
      }
    },
    {
      "id": "enter-display-name",
      "action": "fill",
      "label": "Enter a display name",
      "enabled": true,
      "pageId": "recorder-fixture",
      "elementId": "display-name",
      "value": {
        "kind": "literal",
        "value": "Cliq demo"
      }
    },
    {
      "id": "select-tester-role",
      "action": "select",
      "label": "Select the tester role",
      "enabled": true,
      "pageId": "recorder-fixture",
      "elementId": "role",
      "value": {
        "kind": "literal",
        "value": "tester"
      }
    }
  ],
  "updatedAt": "2026-08-06T11:30:00Z"
}
