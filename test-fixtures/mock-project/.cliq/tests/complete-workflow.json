{
  "schemaVersion": 1,
  "id": "complete-workflow",
  "name": "Complete sample workflow",
  "description": "Fills the form, accepts the terms, navigates to completion, and verifies the result.",
  "tags": [
    "demo",
    "critical"
  ],
  "steps": [
    {
      "id": "open-sample-page",
      "action": "navigate",
      "label": "Open the sample page",
      "enabled": true,
      "url": "http://127.0.0.1:4174/"
    },
    {
      "id": "enter-display-name",
      "action": "fill",
      "label": "Enter the mentor demo name",
      "enabled": true,
      "pageId": "recorder-fixture",
