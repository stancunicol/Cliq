# .NET build output
bin/
obj/

# Environment secrets
.env

# Editor / IDE
.vs/

# /run failure screenshots (debugging artifacts, not source)
/Screenshots/

# GeneratedPages/ is otherwise ignored - it's regenerable output, not source
# a human wrote. LoginPage is the one exception: Demo.Tests compiles and runs
# it directly (see PageObjectGenerator.Demo.Tests.csproj), and LoginPage.Custom.cs
# holds a hand-written method that can't be regenerated. Everything else
# (WwwEmagRoPage, IqcenterComIqPage, ...) can always be reproduced by running
# the generator again, so it doesn't need to live in git.
/GeneratedPages/*
!/GeneratedPages/LoginPage.cs
!/GeneratedPages/LoginPage.Custom.cs
!/GeneratedPages/LoginPage.meta.json
!/GeneratedPages/LoginPageTests.cs