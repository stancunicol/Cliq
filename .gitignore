# Project brief and planning material (kept local only)
/project-details/

# Operating-system and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
.vs/

# Environment and local secrets
.env
.env.*
!.env.example
**/.cliq/secrets.local.json

# Frontend dependencies and output
**/node_modules/
**/dist/
**/dist-electron/
**/.vite/
**/*.tsbuildinfo
**/coverage/

