<UserControl x:Class="Cliq.VisualStudio.CliqBrandMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             IsHitTestVisible="False"
             AutomationProperties.Name="Cliq">
    <Viewbox Stretch="Uniform">
        <Grid Width="64" Height="64">
            <Border Margin="1"
                    CornerRadius="17"
                    BorderThickness="2"
                    BorderBrush="#2E1D49">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1B102E" Offset="0" />
                        <GradientStop Color="#09070D" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Path Data="M 44,19.5 A 17,17 0 1 0 44,44.5"
                  Fill="Transparent"
                  StrokeThickness="7"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round">
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                        <GradientStop Color="#7C3AED" Offset="0" />
                        <GradientStop Color="#C4A5FF" Offset="1" />
                    </LinearGradientBrush>
                </Path.Stroke>
            </Path>
            <Ellipse Width="8.5" Height="8.5" Fill="#EFE7FF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="39.75,15.25,0,0" />
            <Ellipse Width="8.5" Height="8.5" Fill="#8B5CF6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="39.75,40.25,0,0" />
        </Grid>
    </Viewbox>
</UserControl>
