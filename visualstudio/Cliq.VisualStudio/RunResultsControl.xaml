<local:CliqThemedUserControl x:Class="Cliq.VisualStudio.RunResultsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:domain="clr-namespace:Cliq.Domain;assembly=Cliq.Domain"
             xmlns:local="clr-namespace:Cliq.VisualStudio"
             MinWidth="360"
             MinHeight="280"
             KeyboardNavigation.TabNavigation="Continue"
             AutomationProperties.Name="Cliq Run Results">
    <local:CliqThemedUserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:NullToVisibilityConverter x:Key="NullToVisibility" />
        <local:ByteArrayToImageSourceConverter x:Key="ByteArrayToImage" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Cliq.Run.Foreground}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Cliq.Run.ButtonBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Cliq.Run.Foreground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Cliq.Run.Border}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Template" Value="{local:CliqButtonTemplate}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Cliq.Run.ToolbarBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Cliq.Run.Foreground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Cliq.Run.Border}" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="Template" Value="{local:CliqComboBoxTemplate}" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource Cliq.Run.ToolbarBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Cliq.Run.Foreground}" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Cliq.Run.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Cliq.Run.SelectedForeground}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Cliq.Run.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Cliq.Run.SelectedForeground}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Cliq.Run.ToolbarBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Cliq.Run.Foreground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Cliq.Run.Border}" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Cliq.Run.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Cliq.Run.SelectedForeground}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource Cliq.Run.Foreground}" />
            <Setter Property="Padding" Value="6,2" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Cliq.Run.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Cliq.Run.SelectedForeground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Cliq.Run.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </local:CliqThemedUserControl.Resources>

    <Grid Background="{DynamicResource Cliq.Run.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="12,10"
                Background="{DynamicResource Cliq.Run.ToolbarBackground}"
                BorderBrush="{DynamicResource Cliq.Run.Border}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding TestName, TargetNullValue=No run selected}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               AutomationProperties.LiveSetting="Polite" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding RunStatusText}" FontWeight="SemiBold" />
                        <TextBlock Text="  " />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{DynamicResource Cliq.Run.MutedForeground}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ComboBox SelectedValue="{Binding SelectedBrowser}"
                              SelectedValuePath="Tag"
                              MinWidth="120"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="Run browser">
                        <ComboBoxItem Content="Chrome" Tag="{x:Static domain:BrowserKind.Chrome}" />
                        <ComboBoxItem Content="Microsoft Edge" Tag="{x:Static domain:BrowserKind.Edge}" />
                    </ComboBox>
                    <Button Content="Cancel"
                            Click="Cancel_Click"
                            IsEnabled="{Binding IsRunning}"
                            AutomationProperties.Name="Cancel Cliq run" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="150" />
                <RowDefinition Height="6" />
                <RowDefinition Height="2*" MinHeight="120" />
            </Grid.RowDefinitions>

            <Border Margin="10"
                    CornerRadius="7"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource Cliq.Run.Border}"
                    ClipToBounds="True">
                <DataGrid x:Name="StepsGrid"
                          ItemsSource="{Binding Steps}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource Cliq.Run.Background}"
                          Foreground="{DynamicResource Cliq.Run.Foreground}"
                          BorderThickness="0"
                          RowBackground="{DynamicResource Cliq.Run.Background}"
                          AlternatingRowBackground="{DynamicResource Cliq.Run.ToolbarBackground}"
                          SelectionChanged="StepsGrid_SelectionChanged"
                          AutomationProperties.Name="Run step timeline">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85" MinWidth="80" />
                        <DataGridTextColumn Header="Step" Binding="{Binding Label}" Width="240" MinWidth="180" />
                        <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="95" MinWidth="90" />
                        <DataGridTextColumn Header="Breakdown" Binding="{Binding Timing}" Width="160" MinWidth="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <GridSplitter Grid.Row="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource Cliq.Run.Border}" />

            <Grid Grid.Row="2" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="View screenshot"
                            Click="ViewScreenshot_Click"
                            IsEnabled="{Binding SelectedItem.HasScreenshotPath, ElementName=StepsGrid}"
                            AutomationProperties.Name="View selected step screenshot" />
                    <Button Content="Close screenshot"
                            Click="CloseScreenshot_Click"
                            Visibility="{Binding HasScreenshot, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="Close screenshot" />
                </StackPanel>
                <TextBlock Grid.Row="1"
                           Margin="3,10,3,6"
                           Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Cliq.Run.Error}"
                           AutomationProperties.LiveSetting="Assertive" />
                <TextBlock Grid.Row="2"
                           Margin="3,0,3,8"
                           Text="{Binding SelectedItem.Error, ElementName=StepsGrid}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Cliq.Run.Error}"
                           AutomationProperties.Name="Selected step failure"
                           AutomationProperties.LiveSetting="Polite" />
                <Border Grid.Row="3"
                        BorderBrush="{DynamicResource Cliq.Run.Border}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Background="{DynamicResource Cliq.Run.ToolbarBackground}">
                    <Grid>
                        <TextBlock Text="Select a failed step to inspect its screenshot."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="20"
                                   Foreground="{DynamicResource Cliq.Run.MutedForeground}" />
                        <ScrollViewer Visibility="{Binding HasScreenshot, Converter={StaticResource BoolToVisibility}}"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding ScreenshotLabel}"
                                           FontWeight="SemiBold"
                                           Margin="10" />
                                <Image Source="{Binding Screenshot, Converter={StaticResource ByteArrayToImage}}"
                                       Stretch="Uniform"
                                       AutomationProperties.Name="{Binding ScreenshotLabel}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Padding="10,6"
                BorderBrush="{DynamicResource Cliq.Run.Border}"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding RunId, StringFormat=Run ID: {0}}"
                       Foreground="{DynamicResource Cliq.Run.MutedForeground}" />
        </Border>
    </Grid>
</local:CliqThemedUserControl>
