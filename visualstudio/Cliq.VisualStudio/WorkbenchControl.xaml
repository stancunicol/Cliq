<local:CliqThemedUserControl x:Class="Cliq.VisualStudio.WorkbenchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:domain="clr-namespace:Cliq.Domain;assembly=Cliq.Domain"
             xmlns:local="clr-namespace:Cliq.VisualStudio"
             MinWidth="360"
             MinHeight="280"
             KeyboardNavigation.TabNavigation="Continue"
             AutomationProperties.Name="Cliq Workbench">
    <local:CliqThemedUserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:BooleanToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
        <local:NullToVisibilityConverter x:Key="NullToVisibility" />
        <local:NullToVisibilityConverter x:Key="InverseNullToVisibility" Invert="True" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Cliq.Foreground}" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource Cliq.Foreground}" />
            <Setter Property="Padding" Value="0,0,0,4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Cliq.InputBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Cliq.Foreground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Cliq.Border}" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{local:CliqTextBoxTemplate}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Cliq.ComboBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Cliq.ComboForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Cliq.Border}" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="Template" Value="{local:CliqComboBoxTemplate}" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource Cliq.InputBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Cliq.ComboForeground}" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Cliq.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Cliq.SelectedForeground}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Cliq.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Cliq.SelectedForeground}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Cliq.ButtonBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Cliq.Foreground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Cliq.Border}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="Template" Value="{local:CliqButtonTemplate}" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Cliq.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource Cliq.SelectedForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Cliq.Accent}" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource Cliq.SidebarBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Cliq.Foreground}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Cliq.Foreground}" />
            <Setter Property="Padding" Value="5,3" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Cliq.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Cliq.SelectedForeground}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{DynamicResource Cliq.SidebarBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Cliq.Foreground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Cliq.Border}" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,1,0"
                                CornerRadius="6,6,0,0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Cliq.Background}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Cliq.Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Cliq.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Cliq.Background}" />
                    <Setter Property="Foreground" Value="{DynamicResource Cliq.Foreground}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Cliq.ToolbarBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Cliq.Foreground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Cliq.Border}" />
        </Style>
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Cliq.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Cliq.SelectedForeground}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource Cliq.Foreground}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Cliq.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Cliq.SelectedForeground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Cliq.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource Cliq.Background}" />
            <Setter Property="Foreground" Value="{DynamicResource Cliq.Foreground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Cliq.Border}" />
            <Setter Property="RowBackground" Value="{DynamicResource Cliq.Background}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource Cliq.SidebarBackground}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Cliq.Border}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Cliq.Border}" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </local:CliqThemedUserControl.Resources>

    <Grid Background="{DynamicResource Cliq.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="10,8"
                Background="{DynamicResource Cliq.ToolbarBackground}"
                BorderBrush="{DynamicResource Cliq.Border}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Save"
                            ToolTip="Save the selected test or page (Ctrl+S)"
                            AutomationProperties.Name="Save selected item"
                            IsEnabled="{Binding CanSaveSelected}"
                            Click="SaveSelected_Click" />
                    <Button Content="Save All"
                            ToolTip="Save every modified test and page (Ctrl+Shift+S)"
                            AutomationProperties.Name="Save all changes"
                            IsEnabled="{Binding CanSaveAll}"
                            Click="SaveAll_Click" />
                    <Button Content="Reload"
                            ToolTip="Reload the workspace from disk"
                            AutomationProperties.Name="Reload workspace"
                            IsEnabled="{Binding IsNotBusy}"
                            Click="Reload_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CLIQ"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="{DynamicResource Cliq.Accent}"
                               Margin="0,0,14,0" />
                    <TextBlock Text="{Binding DirtySummary}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Cliq.MutedForeground}" />
                    <ProgressBar Width="70"
                                 Height="4"
                                 Margin="12,0,0,0"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Cliq operation in progress" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" IsEnabled="{Binding IsNotBusy}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" MinWidth="150" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource Cliq.SidebarBackground}"
                    BorderBrush="{DynamicResource Cliq.Border}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="26,5,7,5"
                                 AutomationProperties.Name="Search Cliq tests and pages"
                                 ToolTip="Search tests and pages"
                                 VerticalContentAlignment="Center" />
                        <Canvas Width="14"
                                Height="14"
                                Margin="8,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                            <Ellipse Width="9"
                                     Height="9"
                                     Canvas.Left="0"
                                     Canvas.Top="0"
                                     Stroke="{DynamicResource Cliq.MutedForeground}"
                                     StrokeThickness="1.6" />
                            <Line X1="8"
                                  Y1="8"
                                  X2="13.5"
                                  Y2="13.5"
                                  Stroke="{DynamicResource Cliq.MutedForeground}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Canvas>
                    </Grid>
                    <TabControl Grid.Row="1"
                                x:Name="NavigatorTabs"
                                Background="{DynamicResource Cliq.SidebarBackground}"
                                BorderBrush="{DynamicResource Cliq.Border}">
                        <TabItem Header="Tests">
                            <Grid Background="{DynamicResource Cliq.SidebarBackground}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ListBox ItemsSource="{Binding FilteredTests}"
                                         SelectedItem="{Binding SelectedTest}"
                                         SelectionChanged="Tests_SelectionChanged"
                                         DisplayMemberPath="DisplayName"
                                         AutomationProperties.Name="Cliq tests">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem"
                                               BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="+ New"
                                            Click="NewTest_Click"
                                            AutomationProperties.Name="Create test" />
                                    <Button Content="Delete"
                                            IsEnabled="{Binding HasSelectedTest}"
                                            Click="DeleteTest_Click"
                                            AutomationProperties.Name="Delete selected test" />
                                </StackPanel>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Pages">
                            <ListBox ItemsSource="{Binding FilteredPages}"
                                     SelectedItem="{Binding SelectedPage}"
                                     SelectionChanged="Pages_SelectionChanged"
                                     DisplayMemberPath="Name"
                                     AutomationProperties.Name="Cliq pages">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem"
                                           BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource Cliq.Border}"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" />

            <TabControl Grid.Column="2"
                        x:Name="MainTabs"
                        Background="{DynamicResource Cliq.Background}"
                        BorderThickness="0"
                        Padding="8">
                <TabItem Header="Test editor">
                    <Grid Background="{DynamicResource Cliq.Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="14,14,14,0"
                              Visibility="{Binding SelectedTest, Converter={StaticResource NullToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Test editor"
                                       Style="{StaticResource SectionHeading}"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="Run test"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="14,0,0,0"
                                    Padding="16,6"
                                    ToolTip="Run the selected test"
                                    AutomationProperties.Name="Run selected test"
                                    IsEnabled="{Binding HasSelectedTest}"
                                    Click="RunTest_Click" />
                        </Grid>
                        <TextBlock Text="Select a test or create a new one."
                                   Grid.RowSpan="2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   Foreground="{DynamicResource Cliq.MutedForeground}"
                                   Visibility="{Binding SelectedTest, Converter={StaticResource InverseNullToVisibility}}" />
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      Visibility="{Binding SelectedTest, Converter={StaticResource NullToVisibility}}">
                            <Grid Margin="14" MinWidth="620" DataContext="{Binding SelectedTest}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Test name" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Test name" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Test description" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Tags" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Comma-separated tags"
                                                 AutomationProperties.Name="Test tags" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,18,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Steps" Style="{StaticResource SectionHeading}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="+ Add" Click="AddStep_Click" AutomationProperties.Name="Add step" />
                                        <Button Content="↑" IsEnabled="{Binding CanMoveSelectedStepUp}" Click="MoveStepUp_Click" AutomationProperties.Name="Move step up" />
                                        <Button Content="↓" IsEnabled="{Binding CanMoveSelectedStepDown}" Click="MoveStepDown_Click" AutomationProperties.Name="Move step down" />
                                        <Button Content="Duplicate" IsEnabled="{Binding HasSelectedStep}" Click="DuplicateStep_Click" AutomationProperties.Name="Duplicate step" />
                                        <Button Content="Delete" IsEnabled="{Binding HasSelectedStep}" Click="DeleteStep_Click" AutomationProperties.Name="Delete step" />
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="2"
                                        CornerRadius="7"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource Cliq.Border}"
                                        ClipToBounds="True">
                                    <DataGrid ItemsSource="{Binding Steps}"
                                              SelectedItem="{Binding SelectedStep}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              MinHeight="150"
                                              MaxHeight="340"
                                              AlternationCount="2"
                                              BorderThickness="0"
                                              AutomationProperties.Name="Test steps">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="42" />
                                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="120" />
                                            <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="220" />
                                            <DataGridTextColumn Header="Target" Binding="{Binding LocatorDisplay}" Width="360" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <Border Grid.Row="3"
                                        Margin="0,14,0,0"
                                        Padding="12"
                                        BorderBrush="{DynamicResource Cliq.Border}"
                                        BorderThickness="1"
                                        Background="{DynamicResource Cliq.SidebarBackground}"
                                        DataContext="{Binding SelectedStep}"
                                        Visibility="{Binding SelectedStep, Converter={StaticResource NullToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="Selected step" Style="{StaticResource SectionHeading}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="Action" Style="{StaticResource FieldLabel}" />
                                                <ComboBox SelectedValue="{Binding Action, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectedValuePath="Tag"
                                                          AutomationProperties.Name="Step action">
                                                    <ComboBoxItem Content="Navigate" Tag="{x:Static domain:StepAction.Navigate}" />
                                                    <ComboBoxItem Content="Click" Tag="{x:Static domain:StepAction.Click}" />
                                                    <ComboBoxItem Content="Fill" Tag="{x:Static domain:StepAction.Fill}" />
                                                    <ComboBoxItem Content="Select" Tag="{x:Static domain:StepAction.Select}" />
                                                    <ComboBoxItem Content="Press key" Tag="{x:Static domain:StepAction.PressKey}" />
                                                    <ComboBoxItem Content="Assert visible" Tag="{x:Static domain:StepAction.AssertVisible}" />
                                                    <ComboBoxItem Content="Assert text" Tag="{x:Static domain:StepAction.AssertText}" />
                                                    <ComboBoxItem Content="Assert URL" Tag="{x:Static domain:StepAction.AssertUrl}" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                <TextBlock Text="Label" Style="{StaticResource FieldLabel}" />
                                                <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="Step label" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Timeout (ms)" Style="{StaticResource FieldLabel}" />
                                                <TextBox Text="{Binding TimeoutText, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="Step timeout" />
                                            </StackPanel>
                                        </Grid>

                                        <CheckBox Content="Enabled"
                                                  IsChecked="{Binding Enabled}"
                                                  Margin="0,10,0,0"
                                                  Foreground="{DynamicResource Cliq.Foreground}"
                                                  AutomationProperties.Name="Step enabled" />

                                        <StackPanel Margin="0,12,0,0"
                                                    Visibility="{Binding RequiresUrl, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="URL" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Navigate URL" />
                                        </StackPanel>

                                        <Grid Margin="0,12,0,0"
                                              Visibility="{Binding RequiresTarget, Converter={StaticResource BoolToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="Page" Style="{StaticResource FieldLabel}" />
                                                <ComboBox ItemsSource="{Binding AvailablePages}"
                                                          DisplayMemberPath="Name"
                                                          SelectedValuePath="Id"
                                                          SelectedValue="{Binding PageId, UpdateSourceTrigger=PropertyChanged}"
                                                          AutomationProperties.Name="Step page" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Element" Style="{StaticResource FieldLabel}" />
                                                <ComboBox ItemsSource="{Binding AvailableElements}"
                                                          DisplayMemberPath="Name"
                                                          SelectedValuePath="Id"
                                                          SelectedValue="{Binding ElementId, UpdateSourceTrigger=PropertyChanged}"
                                                          AutomationProperties.Name="Step element" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,12,0,0"
                                              Visibility="{Binding RequiresValue, Converter={StaticResource BoolToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="Value source" Style="{StaticResource FieldLabel}" />
                                                <ComboBox SelectedValue="{Binding ValueKind, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectedValuePath="Tag"
                                                          AutomationProperties.Name="Step value source">
                                                    <ComboBoxItem Content="Literal" Tag="literal" />
                                                    <ComboBoxItem Content="Secret key" Tag="secret" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Value or secret key" Style="{StaticResource FieldLabel}" />
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="Step value" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Margin="0,12,0,0"
                                                Padding="8"
                                                BorderBrush="{DynamicResource Cliq.Border}"
                                                BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding LocatorDisplay}"
                                                           FontFamily="Consolas"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="  ⚠ Not found on last scan"
                                                           Foreground="{DynamicResource Cliq.Warning}"
                                                           FontWeight="SemiBold"
                                                           Visibility="{Binding IsElementMissing, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding ValidationSummary}"
                                                   Margin="0,8,0,0"
                                                   Foreground="{DynamicResource Cliq.Error}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="Page inspector">
                    <Grid Background="{DynamicResource Cliq.Background}" DataContext="{Binding SelectedPage}">
                        <TextBlock Text="Select a page to inspect its captured elements."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   Foreground="{DynamicResource Cliq.MutedForeground}"
                                   Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseNullToVisibility}}" />
                        <Grid Margin="14"
                              Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel MaxWidth="420" HorizontalAlignment="Left">
                                <TextBlock Text="Page name" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="16"
                                         AutomationProperties.Name="Page name"
                                         ToolTip="Renaming takes effect in the generated Page Object file after the next Generate." />
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Url}"
                                       Margin="0,4,0,14"
                                       Foreground="{DynamicResource Cliq.MutedForeground}" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Remove not found elements"
                                        IsEnabled="{Binding HasNotFoundElements}"
                                        Click="RemoveNotFoundElements_Click"
                                        ToolTip="Removes every element still flagged as not found on the last scan."
                                        AutomationProperties.Name="Remove not found elements" />
                                <Button x:Name="RegeneratePageButton"
                                        Content="Regenerate"
                                        Click="RegeneratePage_Click"
                                        ToolTip="Regenerates this page's Page Object file only. Use Generate All to also refresh tests that reference it."
                                        AutomationProperties.Name="Generate or regenerate this page's artifacts" />
                                <Button Content="Rescan"
                                        Click="RescanPage_Click"
                                        ToolTip="Re-scans this page's live URL with the installed browser and reconciles its elements."
                                        AutomationProperties.Name="Rescan this page" />
                                <Button Content="Open generated file"
                                        Click="OpenGeneratedFile_Click"
                                        ToolTip="Opens this page's generated Page Object .cs file, if it has been generated."
                                        AutomationProperties.Name="Open this page's generated file" />
                                <Button x:Name="LiveHighlightButton"
                                        Content="Start Live Highlight"
                                        Margin="10,0,0,0"
                                        Click="LiveHighlightButton_Click"
                                        ToolTip="Hover an element in the already-open browser window (see Locate in Browser) to highlight the matching row here, like a DevTools inspector. Opens or reuses that window."
                                        AutomationProperties.Name="Live highlight" />
                            </StackPanel>
                            <Border Grid.Row="3"
                                    CornerRadius="7"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Cliq.Border}"
                                    ClipToBounds="True">
                                <DataGrid x:Name="ElementsGrid"
                                          ItemsSource="{Binding Elements}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          AlternationCount="2"
                                          BorderThickness="0"
                                          MouseDoubleClick="ElementsGrid_MouseDoubleClick"
                                          AutomationProperties.Name="Page elements">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Style.Triggers>
                                                <!-- Distinct from the IsSelected trigger on the base DataGridRow style
                                                     (still wins if both apply, since it's declared after) - a hovered
                                                     element and a selected one are different facts and shouldn't look
                                                     identical. #2979FF matches ScreenshotCapture.AddHighlight's own
                                                     "Cliq" highlight color, so the same element visibly glows the same
                                                     color in both the live browser and this grid. -->
                                                <DataTrigger Binding="{Binding IsHoverHighlighted}" Value="True">
                                                    <Setter Property="Background" Value="#332979FF" />
                                                    <Setter Property="BorderBrush" Value="#2979FF" />
                                                    <Setter Property="BorderThickness" Value="0,1,0,1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Element" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="90" />
                                        <DataGridTextColumn Header="Default action" Binding="{Binding Action}" Width="110" />
                                        <DataGridTextColumn Header="Locator" Binding="{Binding Locator}" Width="2*" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Project">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <Grid Margin="18"
                              MinWidth="620"
                              MaxWidth="850"
                              HorizontalAlignment="Left"
                              DataContext="{Binding Project}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="Save project"
                                        IsEnabled="{Binding IsDirty}"
                                        Click="SaveProject_Click"
                                        AutomationProperties.Name="Save project settings" />
                                <StackPanel>
                                    <TextBlock Text="Project" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock Text="Workspace identity, browser defaults, and generated-code locations."
                                               Foreground="{DynamicResource Cliq.MutedForeground}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <Grid Grid.Row="1" Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Project name" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Project name" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Base URL" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Project base URL" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Default browser" Style="{StaticResource FieldLabel}" />
                                    <ComboBox SelectedValue="{Binding DefaultBrowser}"
                                              SelectedValuePath="Tag"
                                              AutomationProperties.Name="Default browser">
                                        <ComboBoxItem Content="Chrome" Tag="{x:Static domain:BrowserKind.Chrome}" />
                                        <ComboBoxItem Content="Microsoft Edge" Tag="{x:Static domain:BrowserKind.Edge}" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="2"
                                       Text="Generated output"
                                       Style="{StaticResource SectionHeading}"
                                       Margin="0,22,0,10" />
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,12">
                                    <TextBlock Text="Page objects directory" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding PageObjectsDirectory, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Page objects output directory" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,0,12">
                                    <TextBlock Text="Page objects namespace" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding PageObjectsNamespace, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Page objects namespace" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Tests directory" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding TestsDirectory, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Tests output directory" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Tests namespace" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding TestsNamespace, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Tests namespace" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Grid.Row="5"
                                       Text="{Binding ValidationSummary}"
                                       Margin="0,12,0,0"
                                       Foreground="{DynamicResource Cliq.Error}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Cliq settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <StackPanel Margin="18"
                                    MinWidth="470"
                                    MaxWidth="850"
                                    HorizontalAlignment="Left"
                                    DataContext="{Binding Settings}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="Save settings"
                                        IsEnabled="{Binding IsDirty}"
                                        Click="SaveSettings_Click"
                                        AutomationProperties.Name="Save Cliq settings" />
                                <StackPanel>
                                    <TextBlock Text="Cliq settings" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock Text="Identification, execution, scanning, and screenshot behavior."
                                               Foreground="{DynamicResource Cliq.MutedForeground}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Text="Element identification"
                                       Style="{StaticResource SectionHeading}"
                                       Margin="0,22,0,10" />
                            <TextBlock Text="Test ID attribute" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding TestIdAttribute, UpdateSourceTrigger=PropertyChanged}"
                                     Width="330"
                                     HorizontalAlignment="Left"
                                     AutomationProperties.Name="Test ID attribute" />

                            <TextBlock Text="Strategy order"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,14,0,4" />
                            <TextBlock Text="Each element is identified by trying the strategies below in order, top to bottom - the first one that produces a valid locator for that element wins."
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4"
                                       Foreground="{DynamicResource Cliq.Foreground}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="330" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ListBox x:Name="StrategyList"
                                         ItemsSource="{Binding StrategyOrder}"
                                         Height="84"
                                         BorderThickness="1"
                                         BorderBrush="{DynamicResource Cliq.Border}"
                                         AutomationProperties.Name="Identification strategy order" />
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <Button Content="Move up" Click="MoveStrategyUp_Click" />
                                    <Button Content="Move down" Click="MoveStrategyDown_Click" Margin="3,5,3,0" />
                                    <Button Content="Remove" Click="RemoveStrategy_Click" Margin="3,5,3,0" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <ComboBox Width="220"
                                          ItemsSource="{Binding AvailableStrategies}"
                                          SelectedItem="{Binding StrategyToAdd}"
                                          AutomationProperties.Name="Strategy to add" />
                                <Button Content="Add strategy" Click="AddStrategy_Click" />
                            </StackPanel>

                            <TextBlock Text="Ignore ID patterns (one regular expression per line)"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,14,0,4" />
                            <TextBox Text="{Binding IgnorePatternsText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     MinHeight="72"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     AutomationProperties.Name="Ignored ID regular expressions" />

                            <TextBlock Text="Execution"
                                       Style="{StaticResource SectionHeading}"
                                       Margin="0,22,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Default step timeout (ms)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding DefaultStepTimeoutText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Default step timeout" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Page ready timeout (ms)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding PageReadyTimeoutText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Page ready timeout" />
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="Capture a screenshot when a step fails"
                                      IsChecked="{Binding CaptureScreenshotOnFailure}"
                                      Foreground="{DynamicResource Cliq.Foreground}"
                                      Margin="0,10,0,0" />

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Highlight pause (ms) - live runs only, 0 disables it"
                                           Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding HighlightPauseText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Highlight pause" />
                            </StackPanel>

                            <TextBlock Text="Scanning"
                                       Style="{StaticResource SectionHeading}"
                                       Margin="0,22,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Load timeout (ms)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding LoadTimeoutText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Scan load timeout" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Network idle grace (ms)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding NetworkIdleGraceText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Network idle grace" />
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="Capture a screenshot after scanning"
                                      IsChecked="{Binding CaptureScanScreenshot}"
                                      Foreground="{DynamicResource Cliq.Foreground}"
                                      Margin="0,10,0,0" />

                            <TextBlock Text="Base page matching"
                                       Style="{StaticResource SectionHeading}"
                                       Margin="0,22,0,10" />
                            <TextBlock Text="Path (relative to the workspace root) to an existing page object .cs file. When set, Cliq generates a shared BasePage.cs styled after it (driver/wait naming) and every generated page inherits from it."
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4"
                                       Foreground="{DynamicResource Cliq.Foreground}" />
                            <TextBox Text="{Binding ExamplePageObjectFilePath, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Example page object file path" />

                            <TextBlock Text="{Binding ValidationSummary}"
                                       Margin="0,12,0,0"
                                       Foreground="{DynamicResource Cliq.Error}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Secrets">
                    <Grid Margin="18" Background="{DynamicResource Cliq.Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="+ Add secret"
                                        Click="AddSecret_Click"
                                        AutomationProperties.Name="Add secret" />
                                <Button Content="Update value"
                                        IsEnabled="{Binding HasSelectedSecret}"
                                        Click="UpdateSecret_Click"
                                        AutomationProperties.Name="Update selected secret" />
                                <Button Content="Delete"
                                        IsEnabled="{Binding HasSelectedSecret}"
                                        Click="DeleteSecret_Click"
                                        AutomationProperties.Name="Delete selected secret" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Workspace secrets" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="Values stay masked. Entering a new value replaces the stored secret."
                                           Foreground="{DynamicResource Cliq.MutedForeground}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <Border Grid.Row="1"
                                CornerRadius="7"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource Cliq.Border}"
                                ClipToBounds="True">
                            <DataGrid ItemsSource="{Binding Secrets}"
                                      SelectedItem="{Binding SelectedSecret}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      BorderThickness="0"
                                      AutomationProperties.Name="Workspace secrets">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="2*" />
                                    <DataGridTextColumn Header="Value" Binding="{Binding MaskedValue}" Width="*" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2"
                Padding="10,5"
                Background="{DynamicResource Cliq.ToolbarBackground}"
                BorderBrush="{DynamicResource Cliq.Border}"
                BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource Cliq.MutedForeground}" />
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource Cliq.Error}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
        </Border>
    </Grid>
</local:CliqThemedUserControl>
