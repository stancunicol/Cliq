<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />
  <Extern href="KnownImageIds.vsct" />

  <Commands package="guidCliqPackage">
    <Menus>
      <Menu guid="guidCliqCommandSet" id="CliqMainMenu" priority="0x700" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_MM_TOOLSADDINS" />
        <Strings>
          <ButtonText>Cli&amp;q</ButtonText>
          <CommandName>Cliq</CommandName>
        </Strings>
      </Menu>
      <Menu guid="guidCliqCommandSet" id="CliqToolbar" priority="0x1000" type="Toolbar">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_TOOLBAR" />
        <Strings>
          <ButtonText>Cliq</ButtonText>
          <CommandName>Cliq</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidCliqCommandSet" id="CliqMainGroup" priority="0x0100">
        <Parent guid="guidCliqCommandSet" id="CliqMainMenu" />
      </Group>
      <Group guid="guidCliqCommandSet" id="CliqToolbarGroup" priority="0x0100">
        <Parent guid="guidCliqCommandSet" id="CliqToolbar" />
      </Group>
      <Group guid="guidCliqCommandSet" id="CliqSolutionContextGroup" priority="0x0800">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_SOLNNODE" />
      </Group>
      <Group guid="guidCliqCommandSet" id="CliqProjectContextGroup" priority="0x0800">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_PROJNODE" />
      </Group>
      <Group guid="guidCliqCommandSet" id="CliqItemContextGroup" priority="0x0800">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_ITEMNODE" />
      </Group>
      <Group guid="guidCliqCommandSet" id="CliqEditorContextGroup" priority="0x0800">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidCliqCommandSet" id="OpenWorkbench" priority="0x0100" type="Button">
        <Parent guid="guidCliqCommandSet" id="CliqMainGroup" />
        <CommandFlag>IconAndText</CommandFlag>
        <Icon guid="ImageCatalogGuid" id="ToolWindow" />
        <Strings><ButtonText>&amp;Open Workbench</ButtonText></Strings>
      </Button>
      <Button guid="guidCliqCommandSet" id="ScanPage" priority="0x0200" type="Button">
        <Parent guid="guidCliqCommandSet" id="CliqMainGroup" />
        <CommandFlag>IconAndText</CommandFlag>
        <Icon guid="ImageCatalogGuid" id="Search" />
        <Strings><ButtonText>&amp;Scan Page...</ButtonText></Strings>
      </Button>
      <Button guid="guidCliqCommandSet" id="RunSelectedTest" priority="0x0300" type="Button">
        <Parent guid="guidCliqCommandSet" id="CliqMainGroup" />
        <CommandFlag>IconAndText</CommandFlag>
        <Icon guid="ImageCatalogGuid" id="RunTest" />
        <Strings><ButtonText>&amp;Run Selected Test</ButtonText></Strings>
      </Button>
      <Button guid="guidCliqCommandSet" id="GenerateSelected" priority="0x0400" type="Button">
        <Parent guid="guidCliqCommandSet" id="CliqMainGroup" />
        <CommandFlag>IconAndText</CommandFlag>
        <Icon guid="ImageCatalogGuid" id="GenerateFile" />
        <Strings><ButtonText>&amp;Generate Selected</ButtonText></Strings>
      </Button>
      <Button guid="guidCliqCommandSet" id="GenerateAll" priority="0x0500" type="Button">
        <Parent guid="guidCliqCommandSet" id="CliqMainGroup" />
        <CommandFlag>IconAndText</CommandFlag>
        <Icon guid="ImageCatalogGuid" id="GenerateAllFromTemplate" />
        <Strings><ButtonText>Generate &amp;All</ButtonText></Strings>
      </Button>
      <Button guid="guidCliqCommandSet" id="RecordInDesktop" priority="0x0600" type="Button">
        <Parent guid="guidCliqCommandSet" id="CliqMainGroup" />
        <CommandFlag>IconAndText</CommandFlag>
        <Icon guid="ImageCatalogGuid" id="Record" />
        <Strings><ButtonText>Record in Cliq &amp;Desktop</ButtonText></Strings>
      </Button>
      <Button guid="guidCliqCommandSet" id="Refresh" priority="0x0700" type="Button">
        <Parent guid="guidCliqCommandSet" id="CliqMainGroup" />
        <CommandFlag>IconAndText</CommandFlag>
        <Icon guid="ImageCatalogGuid" id="Refresh" />
        <Strings><ButtonText>Re&amp;fresh</ButtonText></Strings>
      </Button>
      <Button guid="guidCliqCommandSet" id="Settings" priority="0x0800" type="Button">
        <Parent guid="guidCliqCommandSet" id="CliqMainGroup" />
        <CommandFlag>IconAndText</CommandFlag>
        <Icon guid="ImageCatalogGuid" id="Settings" />
        <Strings><ButtonText>Se&amp;ttings</ButtonText></Strings>
      </Button>

      <Button guid="guidCliqCommandSet" id="BindWorkspace" priority="0x0100" type="Button">
        <Parent guid="guidCliqCommandSet" id="CliqSolutionContextGroup" />
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Icon guid="ImageCatalogGuid" id="OpenProjectFolder" />
        <Strings><ButtonText>Use as Cliq Workspace</ButtonText></Strings>
      </Button>
      <Button guid="guidCliqCommandSet" id="OpenScopedWorkbench" priority="0x0200" type="Button">
        <Parent guid="guidCliqCommandSet" id="CliqSolutionContextGroup" />
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Icon guid="ImageCatalogGuid" id="ToolWindow" />
        <Strings><ButtonText>Open Cliq Workbench</ButtonText></Strings>
      </Button>
      <Button guid="guidCliqCommandSet" id="GenerateScopedAll" priority="0x0300" type="Button">
        <Parent guid="guidCliqCommandSet" id="CliqSolutionContextGroup" />
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Icon guid="ImageCatalogGuid" id="GenerateAllFromTemplate" />
        <Strings><ButtonText>Generate All Cliq Artifacts</ButtonText></Strings>
      </Button>
      <Button guid="guidCliqCommandSet" id="BindProjectAndOpen" priority="0x0100" type="Button">
        <Parent guid="guidCliqCommandSet" id="CliqItemContextGroup" />
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Icon guid="ImageCatalogGuid" id="OpenProjectFolder" />
        <Strings><ButtonText>Bind Project and Open Cliq Workbench</ButtonText></Strings>
      </Button>
      <Button guid="guidCliqCommandSet" id="OpenCliqDocument" priority="0x0200" type="Button">
        <Parent guid="guidCliqCommandSet" id="CliqItemContextGroup" />
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Icon guid="ImageCatalogGuid" id="OpenFile" />
        <Strings><ButtonText>Open in Cliq Workbench</ButtonText></Strings>
      </Button>
      <Button guid="guidCliqCommandSet" id="RunCliqTest" priority="0x0300" type="Button">
        <Parent guid="guidCliqCommandSet" id="CliqItemContextGroup" />
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Icon guid="ImageCatalogGuid" id="RunTest" />
        <Strings><ButtonText>Run Cliq Test</ButtonText></Strings>
      </Button>
      <Button guid="guidCliqCommandSet" id="GenerateCliqDocument" priority="0x0400" type="Button">
        <Parent guid="guidCliqCommandSet" id="CliqItemContextGroup" />
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Icon guid="ImageCatalogGuid" id="GenerateFile" />
        <Strings><ButtonText>Generate Cliq Artifact</ButtonText></Strings>
      </Button>
      <Button guid="guidCliqCommandSet" id="RescanCliqPage" priority="0x0500" type="Button">
        <Parent guid="guidCliqCommandSet" id="CliqItemContextGroup" />
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Icon guid="ImageCatalogGuid" id="Refresh" />
        <Strings><ButtonText>Rescan Cliq Page...</ButtonText></Strings>
      </Button>
      <Button guid="guidCliqCommandSet" id="ScanSelectedUrl" priority="0x0100" type="Button">
        <Parent guid="guidCliqCommandSet" id="CliqEditorContextGroup" />
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Icon guid="ImageCatalogGuid" id="Web" />
        <Strings><ButtonText>Scan URL in Cliq...</ButtonText></Strings>
      </Button>
    </Buttons>
  </Commands>

