  </CommandPlacements>

  <KeyBindings>
    <KeyBinding guid="guidCliqCommandSet" id="OpenWorkbench"
                editor="guidVSStd97" key1="C" mod1="CONTROL ALT"
                key2="W" mod2="CONTROL ALT" />
    <KeyBinding guid="guidCliqCommandSet" id="RunSelectedTest"
                editor="guidVSStd97" key1="C" mod1="CONTROL ALT"
                key2="R" mod2="CONTROL ALT" />
  </KeyBindings>

