<UserControl x:Class="Cliq.VisualStudio.MergeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Cliq.VisualStudio"
             MinWidth="420"
             MinHeight="320"
             KeyboardNavigation.TabNavigation="Continue"
             AutomationProperties.Name="Cliq Pending Merges">
    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:BooleanToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Cliq.Merge.Foreground}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Cliq.Merge.InputBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Cliq.Merge.Foreground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Cliq.Merge.Border}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Cliq.Merge.ButtonBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Cliq.Merge.Foreground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Cliq.Merge.Border}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Cliq.Merge.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource Cliq.Merge.SelectedForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Cliq.Merge.Accent}" />
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Background" Value="{DynamicResource Cliq.Merge.Background}" />
            <Setter Property="Foreground" Value="{DynamicResource Cliq.Merge.Foreground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Cliq.Merge.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Cliq.Merge.Foreground}" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{DynamicResource Cliq.Merge.ToolbarBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Cliq.Merge.Foreground}" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,1,0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Cliq.Merge.Border}"
                                BorderThickness="1">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Cliq.Merge.TabActiveBackground}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Cliq.Merge.Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Cliq.Merge.TabActiveBackground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Cliq.Merge.ToolbarBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Cliq.Merge.Foreground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Cliq.Merge.Border}" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource Cliq.Merge.Foreground}" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource Cliq.Merge.Background}" />
            <Setter Property="Foreground" Value="{DynamicResource Cliq.Merge.Foreground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Cliq.Merge.Border}" />
            <Setter Property="RowBackground" Value="{DynamicResource Cliq.Merge.Background}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource Cliq.Merge.ToolbarBackground}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Cliq.Merge.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0"
                    Background="{DynamicResource Cliq.Merge.Background}"
                    BorderThickness="0"
                    Padding="14">
            <TabItem Header="Resolve conflicts">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="No pending custom-method conflicts."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Cliq.Merge.MutedForeground}"
                               Visibility="{Binding HasPendingPages, Converter={StaticResource InverseBoolToVisibility}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasPendingPages, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding PendingPages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,18">
                                        <TextBlock Text="{Binding PageObjectName}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding Candidates}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Expander IsExpanded="{Binding IsExpanded}">
                                                        <Expander.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Signature}" FontFamily="Consolas" />
                                                                <TextBlock Text=" &#9888;"
                                                                           Foreground="{DynamicResource Cliq.Merge.Warning}"
                                                                           FontWeight="Bold"
                                                                           ToolTip="{Binding SyntaxErrorSummary}"
                                                                           Visibility="{Binding HasSyntaxError, Converter={StaticResource BoolToVisibility}}"
                                                                           AutomationProperties.Name="Has a syntax error" />
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <StackPanel Margin="16,10,0,0">
                                                            <TextBox Text="{Binding SourceText, Mode=OneWay}"
                                                                     IsReadOnly="True"
                                                                     FontFamily="Consolas"
                                                                     AcceptsReturn="True"
                                                                     TextWrapping="NoWrap"
                                                                     MaxHeight="220"
                                                                     VerticalScrollBarVisibility="Auto"
                                                                     HorizontalScrollBarVisibility="Auto"
                                                                     AutomationProperties.Name="{Binding Signature}" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                                <RadioButton Content="Carry over into the new file"
                                                                             IsChecked="{Binding IsCarryOver}"
                                                                             IsEnabled="{Binding CanCarryOver}"
                                                                             Visibility="{Binding CanCarryOver, Converter={StaticResource BoolToVisibility}}"
                                                                             ToolTip="This method's boundaries could not be trusted while extracting it, so its text can't be carried over as-is. Fix it in the generated file and regenerate instead." />
                                                                <RadioButton Content="Defer to the waiting list"
                                                                             IsChecked="{Binding IsDefer}" />
                                                                <RadioButton Content="Discard permanently"
                                                                             IsChecked="{Binding IsDiscard}"
                                                                             Foreground="{DynamicResource Cliq.Merge.Error}"
                                                                             ToolTip="Drops this method entirely - it will not be carried into the new file and will not appear in the waiting list. This cannot be undone."
                                                                             AutomationProperties.Name="Discard permanently - cannot be undone" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Expander>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="1"
                            Content="Resolve"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0"
                            IsEnabled="{Binding HasPendingPages}"
                            Click="Resolve_Click"
                            AutomationProperties.Name="Resolve pending merges" />
                </Grid>
            </TabItem>

            <TabItem Header="Waiting list">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right"
                                Content="Refresh"
                                Click="RefreshWaitingList_Click"
                                AutomationProperties.Name="Refresh waiting list" />
                        <TextBlock Text="Custom methods deferred from a merge, across every page."
                                   Foreground="{DynamicResource Cliq.Merge.MutedForeground}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding WaitingList}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              AlternationCount="2"
                              AutomationProperties.Name="Waiting list">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Page" Binding="{Binding PageObjectName}" Width="*" />
                            <DataGridTextColumn Header="Method" Binding="{Binding Signature}" Width="2*" />
                            <DataGridTextColumn Header="Deferred at" Binding="{Binding DeferredAt}" Width="160" />
                            <DataGridTemplateColumn Header="Actions" Width="210">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Include now"
                                                    Click="IncludeNow_Click"
                                                    IsEnabled="{Binding CanInclude}"
                                                    ToolTip="This method still has a syntax error - fix it in the generated file and regenerate instead of including this stored snapshot." />
                                            <Button Content="Discard" Click="Discard_Click" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1"
                Padding="10,5"
                Background="{DynamicResource Cliq.Merge.ToolbarBackground}"
                BorderBrush="{DynamicResource Cliq.Merge.Border}"
                BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Cliq.Merge.MutedForeground}" />
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource Cliq.Merge.Error}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
